# Copy to .env.local for development. On Vercel add these under Project Settings > Environment Variables.
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.

# Backend base URL, including /api (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public URL of this website (used for canonical links and share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number with country code, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Optional: GA4 measurement id, e.g. G-XXXXXXXXXX. Fires a generate_lead event on enquiry submit.
NEXT_PUBLIC_GA_ID=
